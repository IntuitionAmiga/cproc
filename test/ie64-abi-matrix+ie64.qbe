type :small.1 = { w, d, }
export
function :small.1 $make_small(l %.1, d %.3, l %.5, l %.7, l %.9, l %.11, l %.13, l %.15, l %.17) {
@start.1
	%.2 =l alloc4 4
	storew %.1, %.2
	%.4 =l alloc8 8
	stored %.3, %.4
	%.6 =l alloc8 8
	storel %.5, %.6
	%.8 =l alloc8 8
	storel %.7, %.8
	%.10 =l alloc8 8
	storel %.9, %.10
	%.12 =l alloc8 8
	storel %.11, %.12
	%.14 =l alloc8 8
	storel %.13, %.14
	%.16 =l alloc8 8
	storel %.15, %.16
	%.18 =l alloc8 8
	storel %.17, %.18
	%.19 =l alloc8 16
@body.2
	%.20 =w loadw %.2
	%.21 =l extsw %.20
	%.22 =l loadl %.6
	%.23 =l add %.21, %.22
	%.24 =l loadl %.8
	%.25 =l add %.23, %.24
	%.26 =l loadl %.10
	%.27 =l add %.25, %.26
	%.28 =l loadl %.12
	%.29 =l add %.27, %.28
	%.30 =l loadl %.14
	%.31 =l add %.29, %.30
	%.32 =l loadl %.16
	%.33 =l add %.31, %.32
	%.34 =l loadl %.18
	%.35 =l add %.33, %.34
	%.36 =l add %.19, 0
	storew %.35, %.36
	%.37 =d loadd %.4
	%.38 =l add %.19, 8
	stored %.37, %.38
	ret %.19
}
export
function l $copy_isolation(:small.1 %.1) {
@start.3
@body.4
	%.2 =l add %.1, 0
	storew 99, %.2
	%.3 =l add %.1, 0
	%.4 =w loadw %.3
	%.5 =l extsw %.4
	ret %.5
}
export
function l $call_matrix(l %.1) {
@start.5
	%.2 =l alloc8 8
	storel %.1, %.2
	%.3 =l alloc8 16
	%.4 =l alloc8 8
@body.6
	storel extern $copy_isolation, %.4
	%.5 =l loadl %.2
	%.6 =l add %.5, 0
	%.7 =w loadw %.6
	%.8 =l loadl %.2
	%.9 =l add %.8, 8
	%.10 =d loadd %.9
	%.11 =l extsw 1
	%.12 =l extsw 2
	%.13 =l extsw 3
	%.14 =l extsw 4
	%.15 =l extsw 5
	%.16 =l extsw 6
	%.17 =l extsw 7
	%.18 =l extsw %.7
	%.19 =:small.1 call extern $make_small(l %.18, d %.10, l %.11, l %.12, l %.13, l %.14, l %.15, l %.16, l %.17)
	%.20 =l loadl %.19
	storel %.20, %.3
	%.21 =l add %.19, 8
	%.22 =l add %.3, 8
	%.23 =l loadl %.21
	storel %.23, %.22
	%.24 =l loadl %.4
	%.25 =l call %.24(:small.1 %.3)
	%.26 =s call extern $fp_exhaust(s s_0, s s_1, s s_2, s s_3, s s_4, s s_5, s s_6, d d_7, s s_8)
	%.27 =l extsw 1
	%.28 =l extsw 2
	%.29 =l extsw 3
	%.30 =l extsw 4
	%.31 =l extsw 5
	%.32 =l extsw 6
	%.33 =l extsw 7
	%.34 =l call extern $overflow_aggregate(l %.27, l %.28, l %.29, l %.30, l %.31, l %.32, :small.1 %.3, l %.33)
	ret %.34
}
export
function l $vararg_matrix(l %.1, d %.3, :small.1 %.5, ...) {
@start.7
	%.2 =l alloc4 4
	storew %.1, %.2
	%.4 =l alloc8 8
	stored %.3, %.4
	%.6 =l alloc8 8
	%.7 =l alloc8 16
	%.8 =l alloc8 16
	%.9 =l alloc8 8
	%.10 =l alloc8 8
@body.8
	vastart %.6
	%.11 =l ie64vaarg %.6, 4104
	%.12 =l loadl %.11
	storel %.12, %.7
	%.13 =l add %.11, 8
	%.14 =l add %.7, 8
	%.15 =l loadl %.13
	storel %.15, %.14
	%.16 =l vaarg %.6
	storel %.16, %.9
	%.17 =l ie64vaarg %.6, 4104
	%.18 =l loadl %.17
	storel %.18, %.8
	%.19 =l add %.17, 8
	%.20 =l add %.8, 8
	%.21 =l loadl %.19
	storel %.21, %.20
	%.22 =l vaarg %.6
	storel %.22, %.10
	%.23 =w loadw %.2
	%.24 =d loadd %.4
	%.25 =w ceqd %.24, d_2
	%.26 =w add %.23, %.25
	%.27 =l add %.5, 0
	%.28 =w loadw %.27
	%.29 =w add %.26, %.28
	%.30 =l add %.7, 0
	%.31 =w loadw %.30
	%.32 =w add %.29, %.31
	%.33 =l extsw %.32
	%.34 =l loadl %.9
	%.35 =l add %.33, %.34
	%.36 =l add %.8, 0
	%.37 =l loadl %.36
	%.38 =l add %.35, %.37
	%.39 =l loadl %.10
	%.40 =l add %.38, %.39
	ret %.40
}
type :wide.2 = { l, b, h, }
export
function l $call_vararg(:small.1 %.1, :wide.2 %.2) {
@start.9
	%.3 =l alloc8 16
@body.10
	storew 3, %.3
	%.4 =l add %.3, 4
	storew 0, %.4
	%.5 =l add %.3, 8
	stored d_4, %.5
	%.6 =l extsw 1
	%.7 =l call extern $vararg_matrix(l %.6, d d_2, :small.1 %.3, ..., :small.1 %.1, l 5, :wide.2 %.2, l 6)
	ret %.7
}
