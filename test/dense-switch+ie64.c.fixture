unsigned f(int x, unsigned y)
{
	switch (x) {
	case -2: return y + 1;
	case -1: return y >> 1;
	case 1: return y ^ 2;
	case 2: return y * 3;
	case 3: return y + 4;
	case 4: return y ^ 5;
	case 5: return y >> 2;
	case 6: return y ^ 6;
	case 7: return y + 7;
	default: return y;
	}
}

unsigned sparse(unsigned long x, unsigned y)
{
	switch (x) {
	case 0: return y + 1;
	case 1: return y >> 1;
	case 0x100UL: return y + 17;
	case 0x10000UL: return y + 18;
	case 0x1000000UL: return y + 19;
	case 0x100000000UL: return y ^ 2;
	case 0x10000000000UL: return y + 20;
	case 0x1000000000000UL: return y + 21;
	case 0xffffffffffffffffUL: return y * 3;
	default: return y;
	}
}

unsigned small(unsigned x, unsigned y)
{
	switch (x) {
	case 0: return y + 1;
	case 1: return y >> 1;
	case 2: return y ^ 2;
	case 3: return y * 3;
	case 4: return y + 4;
	case 5: return y ^ 5;
	case 6: return y >> 2;
	case 7: return y ^ 6;
	default: return y;
	}
}
